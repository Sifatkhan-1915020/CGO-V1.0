# Gemini API Key (for Vision OCR & Bangla Fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Authenticated SMTP Email Dispatch (for OTP Guard)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM=your_email@gmail.com

# Redis Telemetry & Fast-Buffer Engine (Optional, defaults to embedded cache)
REDIS_URL=redis://127.0.0.1:6379/0

# Optional Remote Kaggle / Colab GPU Unlimited-OCR Server Connection
# Option A: Tailscale WireGuard Mesh (Recommended: Direct P2P encryption, no 100s timeout, zero public exposure)
# TAILSCALE_URL=http://100.x.y.z:8000
# Option B: Cloudflare Quick Tunnel (Public HTTPS edge, zero account signup needed)
# CLOUDFLARE_TUNNEL_URL=https://xxxx.trycloudflare.com
OCR_API_URL=
